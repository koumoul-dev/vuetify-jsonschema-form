<script setup>
// @ts-nocheck

import { StatefulLayout } from '@json-layout/core/state'
import { ref, shallowRef, getCurrentInstance, useSlots, computed<% if (webmcp) { %>, watch, onScopeDispose, toRaw<% } %> } from 'vue'
import { useElementSize } from '@vueuse/core'
<% if (webmcp) { %>
import { WebMCP } from '@json-layout/core/webmcp'
<% } %>
import Tree from '<%- baseImport %>/components/tree.vue'
import { useVjsf, emits } from '<%- baseImport %>/composables/use-vjsf.js'
import '<%- baseImport %>/styles/vjsf.css'

<% compImports.forEach(function({compName, compImport}){ %>
import <%= compName %> from '<%- compImport %>'
<% }); %>

<%- compiledLayoutCode %>

const nodeComponents = {
  <% compImports.forEach(function({comp, compName}){ %>
  "<%= comp %>": <%= compName %>,
  <% }); %>  
}

const props = defineProps({
  modelValue: {
    type: null,
    default: null
  },
  options: {
    /** @type import('vue').PropType<import('<%- baseImport %>/types.js').PartialVjsfOptions | null> */
    type: Object,
    default: null
  }<% if (webmcp) { %>,
  prefixName: {
    type: String,
    default: null
  },
  dataTitle: {
    type: String,
    default: null
  },
  // deprecated: the form's skill now comes with its tools, there is no sub-agent anymore
  subAgent: {
    type: Boolean,
    default: false
  }<% } %>
})

const emit = defineEmits(emits)

<% if (webmcp) { %>
// the data last given to the parent, to tell its echo through v-model from other data loaded
let lastEmittedData
const emitAndTrack = (name, ...args) => {
  if (name === 'update:modelValue') lastEmittedData = args[0]
  emit(name, ...args)
}
<% } %>
const { el, statefulLayout, stateTree } = useVjsf(
  null,
  computed(() => props.modelValue),
  computed(() => ({...props.options, components: <%- JSON.stringify(pluginsComponents) %>})),
  nodeComponents,
  <%= webmcp ? 'emitAndTrack' : 'emit' %>,
  null,
  null,
  computed(() => compiledLayout)
)
<% if (webmcp) { %>
if (props.subAgent) console.warn('vjsf: the subAgent prop is deprecated and ignored, the form\'s skill now comes with its tools')

/** @type import('vue').ShallowRef<WebMCP | null> */
const webMCP = shallowRef(null)
watch(statefulLayout, () => {
  if (webMCP.value) webMCP.value.unregisterTools()
  if (statefulLayout.value) {
    webMCP.value = new WebMCP(
      /** @type {import('@json-layout/core').StatefulLayout} */(/** @type {unknown} */(statefulLayout.value)),
      { prefixName: props.prefixName, dataTitle: props.dataTitle }
    )
    webMCP.value.registerTools()
  }
}, { immediate: true })

// other data loaded into the form (after a save, to start a new document): the values it
// holds count as picked, not typed by the agent
watch(() => props.modelValue, (data) => {
  if (webMCP.value && toRaw(data) !== toRaw(lastEmittedData)) webMCP.value.resetBaseline()
})

// always unregister our tools when the component is torn down, otherwise a later
// instance mounted with the same prefixName would fail to register them again
onScopeDispose(() => {
  if (webMCP.value) webMCP.value.unregisterTools()
})
<% } %>
</script>

<template>
  <div
    ref="el"
    class="vjsf"
  >
    <tree
      v-if="statefulLayout && stateTree"
      :model-value="stateTree"
      :stateful-layout="statefulLayout"
    />
  </div>
</template>